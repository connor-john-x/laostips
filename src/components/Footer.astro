---
import { CATEGORIES, CONTACT_EMAIL, SITE_NAME, SOCIALS } from "../consts";
import type { Lang } from "../i18n/config";
import { useTranslations, localizePath } from "../i18n/utils";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const quickLinks = [
	{ key: "nav.about", path: "/about/" },
	{ key: "nav.contact", path: "/contact/" },
	{ key: "nav.advertise", path: "/advertise/" },
	{ key: "nav.blog", path: "/blog/" },
] as const;
---

<footer>
	<div class="container">
		<div class="top">
			<div class="about">
				<div class="brand">
					<span class="brand-mark">LT</span>
					<span>{SITE_NAME}</span>
				</div>
				<p>{t("site.description")}</p>
				<p class="email">
					<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
				</p>
			</div>

			<div class="col">
				<h4>{t("footer.categories")}</h4>
				<ul>
					{
						CATEGORIES.map((cat) => (
							<li>
								<a href={localizePath(`/${cat}/`, lang)}>{t(`category.${cat}.name`)}</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="col">
				<h4>{t("footer.quickLinks")}</h4>
				<ul>
					{
						quickLinks.map((link) => (
							<li>
								<a href={localizePath(link.path, lang)}>{t(link.key)}</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="col">
				<h4>{t("footer.follow")}</h4>
				<ul>
					{
						SOCIALS.map((social) => (
							<li>
								<a href={social.href} target="_blank" rel="noopener">
									{social.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="bottom">
			<p>&copy; {year} {SITE_NAME}. {t("footer.rights")}.</p>
			<p class="disclaimer">{t("footer.disclaimer")}</p>
		</div>
	</div>
</footer>

<style>
	footer {
		margin-top: 4rem;
		padding: 3rem 0 2rem;
		background: #0d1526;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.95rem;
	}
	.top {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1fr;
		gap: 2rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		color: #fff;
		font-weight: 700;
		font-size: 1.15rem;
		margin-bottom: 0.75rem;
	}
	.brand-mark {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 8px;
		background: var(--accent);
		font-size: 0.8rem;
	}
	.about p {
		margin: 0 0 0.5rem;
		max-width: 36ch;
	}
	.email a {
		color: var(--gold);
	}
	h4 {
		color: #fff;
		font-size: 0.95rem;
		margin-bottom: 0.75rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}
	ul a {
		color: rgba(255, 255, 255, 0.72);
	}
	ul a:hover {
		color: #fff;
		text-decoration: none;
	}
	.bottom {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		padding-top: 1.5rem;
		font-size: 0.85rem;
	}
	.bottom p {
		margin: 0;
	}
	.disclaimer {
		opacity: 0.7;
		max-width: 60ch;
	}
	@media (max-width: 860px) {
		.top {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 520px) {
		.top {
			grid-template-columns: 1fr;
		}
	}
</style>
