---
import type { Lang } from "../i18n/config";
import { useTranslations, localizePath } from "../i18n/utils";

interface Crumb {
	label: string;
	href?: string;
}
interface Props {
	lang: Lang;
	items: Crumb[];
}
const { lang, items } = Astro.props;
const t = useTranslations(lang);
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
	<ol>
		<li>
			<a href={localizePath("/", lang)}>{t("common.breadcrumbHome")}</a>
		</li>
		{
			items.map((item) => (
				<li>
					{item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
				</li>
			))
		}
	</ol>
</nav>

<style>
	.breadcrumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}
	.breadcrumbs li:not(:last-child)::after {
		content: "/";
		margin-left: 0.4rem;
		color: var(--border);
	}
	.breadcrumbs a {
		color: rgb(var(--gray));
	}
	.breadcrumbs a:hover {
		color: var(--accent);
	}
</style>
