---
import { SITE_NAME } from "../consts";
import type { Lang } from "../i18n/config";
import { useTranslations, localizePath, stripLocale } from "../i18n/utils";
import LanguagePicker from "./LanguagePicker.astro";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const currentPath = stripLocale(Astro.url.pathname);

const links = [
	{ key: "nav.home", path: "/" },
	{ key: "nav.travel", path: "/travel/" },
	{ key: "nav.work", path: "/work/" },
	{ key: "nav.living", path: "/living/" },
	{ key: "nav.blog", path: "/blog/" },
	{ key: "nav.about", path: "/about/" },
] as const;

const isActive = (path: string) =>
	path === "/" ? currentPath === "/" : currentPath.startsWith(path);
---

<header>
	<div class="container bar">
		<a class="brand" href={localizePath("/", lang)}>
			<span class="brand-mark">LT</span>
			<span class="brand-name">{SITE_NAME}</span>
		</a>

		<nav class="desktop-nav" aria-label="Main">
			{
				links.map((link) => (
					<a href={localizePath(link.path, lang)} class:list={{ active: isActive(link.path) }}>
						{t(link.key)}
					</a>
				))
			}
		</nav>

		<div class="actions">
			<LanguagePicker lang={lang} />
			<a class="btn btn-primary advertise" href={localizePath("/advertise/", lang)}>
				{t("nav.advertise")}
			</a>
		</div>
	</div>

	<details class="mobile-nav">
		<summary aria-label="Menu">
			<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
				><path
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					d="M4 7h16M4 12h16M4 17h16"></path></svg
			>
			<span>{t("nav.home")} · Menu</span>
		</summary>
		<div class="mobile-links">
			{
				links.map((link) => (
					<a href={localizePath(link.path, lang)} class:list={{ active: isActive(link.path) }}>
						{t(link.key)}
					</a>
				))
			}
			<a href={localizePath("/advertise/", lang)}>{t("nav.advertise")}</a>
		</div>
	</details>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--border);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 64px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-weight: 700;
		color: rgb(var(--black));
		white-space: nowrap;
	}
	.brand:hover {
		text-decoration: none;
	}
	.brand-mark {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 9px;
		background: var(--accent);
		color: #fff;
		font-size: 0.85rem;
		letter-spacing: 0.03em;
	}
	.brand-name {
		font-size: 1.15rem;
	}
	.desktop-nav {
		display: flex;
		gap: 0.15rem;
		flex: 1;
		justify-content: center;
	}
	.desktop-nav a {
		padding: 0.5em 0.7em;
		border-radius: 8px;
		color: rgb(var(--gray-dark));
		font-size: 0.95rem;
		font-weight: 500;
	}
	.desktop-nav a:hover {
		background: var(--bg-soft);
		color: var(--accent);
		text-decoration: none;
	}
	.desktop-nav a.active {
		color: var(--accent);
		font-weight: 700;
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.advertise {
		padding: 0.55em 1.1em;
		font-size: 0.9rem;
	}
	.mobile-nav {
		display: none;
		border-top: 1px solid var(--border);
	}
	.mobile-nav summary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1rem;
		cursor: pointer;
		list-style: none;
		font-weight: 700;
	}
	.mobile-nav summary::-webkit-details-marker {
		display: none;
	}
	.mobile-links {
		display: flex;
		flex-direction: column;
		padding: 0 0.5rem 0.75rem;
	}
	.mobile-links a {
		padding: 0.7em 0.75em;
		border-radius: 8px;
		color: rgb(var(--gray-dark));
	}
	.mobile-links a.active {
		color: var(--accent);
		font-weight: 700;
		background: var(--accent-soft);
	}
	@media (max-width: 960px) {
		.desktop-nav {
			display: none;
		}
		.mobile-nav {
			display: block;
		}
		.advertise {
			display: none;
		}
	}
</style>
