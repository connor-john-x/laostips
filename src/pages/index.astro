---
import BaseHead from "../components/BaseHead.astro";
import { defaultLang } from "../i18n/config";
import { localizePath } from "../i18n/utils";
import { DISABLE_AUTO_TRANSLATE, SITE_NAME } from "../consts";

const fallback = localizePath("/", defaultLang);
---

<!doctype html>
<html lang="en" translate={DISABLE_AUTO_TRANSLATE ? "no" : undefined}>
	<head>
		<BaseHead
			title={SITE_NAME}
			description="LaosTips — travel, work and life in Laos"
			lang={defaultLang}
			noindex={true}
		/>
		<meta http-equiv="refresh" content={`0;url=${fallback}`} />
		<script is:inline>
			(function () {
				var supported = ["zh", "en", "lo", "th"];
				var stored = null;
				try {
					stored = localStorage.getItem("laostips-lang");
				} catch (e) {}
				var nav = (navigator.language || "").slice(0, 2).toLowerCase();
				var lang =
					supported.indexOf(stored) !== -1
						? stored
						: supported.indexOf(nav) !== -1
							? nav
							: "zh";
				location.replace("/" + lang + "/");
			})();
		</script>
	</head>
	<body>
		<p style="font-family: sans-serif; padding: 2rem; text-align: center">
			Redirecting… <a href={fallback}>Continue</a>
		</p>
	</body>
</html>
