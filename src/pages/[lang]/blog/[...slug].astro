---
import { getCollection, render } from "astro:content";
import type { Lang } from "../../../i18n/config";
import { parseContentId } from "../../../i18n/utils";
import { getPostsByLang, toCard, readingMinutes } from "../../../lib/posts";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog", (post) => !post.data.draft);
	return posts.map((post) => {
		const { lang, slug } = parseContentId(post.id);
		return { params: { lang, slug }, props: { post } };
	});
}

const { post } = Astro.props;
const lang = Astro.params.lang as Lang;
const { slug } = parseContentId(post.id);
const { Content } = await render(post);

const related = (await getPostsByLang(lang))
	.filter((p) => p.data.category === post.data.category && p.id !== post.id)
	.slice(0, 3)
	.map(toCard);
---

<ArticleLayout
	lang={lang}
	slug={slug}
	title={post.data.title}
	description={post.data.description}
	pubDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
	heroImage={post.data.heroImage}
	category={post.data.category}
	tags={post.data.tags}
	author={post.data.author}
	readingMinutes={readingMinutes(post)}
	related={related}
>
	<Content />
</ArticleLayout>
